# PostgreSQL Local Docker
DATABASE_URL="postgresql://homeland:homeland123@localhost:5432/homeland?schema=public"

# Redis Local Docker
REDIS_URL="redis://localhost:6379"

# API Local Setup
PORT=3001
NODE_ENV="development"
JWT_SECRET="homeland_super_secret_key_change_in_production"
APP_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ALLOW_REGISTRATION="false"
ENABLE_SWAGGER="true"
RUN_DB_MIGRATIONS="false"
NEXT_PUBLIC_ALLOW_REGISTRATION="false"

# Seed credentials (required when SEED_MODE=production; never commit real values)
SEED_DEFAULT_PASSWORD=""
SEED_OWNER_A_TEMPORARY_PASSWORD=""
SEED_OWNER_B_TEMPORARY_PASSWORD=""
