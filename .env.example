# Database
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/homeland_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API
PORT=3001
NODE_ENV="development"
JWT_SECRET="homeland_super_secret_key_change_in_production"

# Seed credentials (required when SEED_MODE=production; never commit real values)
SEED_OWNER_A_TEMPORARY_PASSWORD=""
SEED_OWNER_B_TEMPORARY_PASSWORD=""

# Optional local E2E credentials
E2E_DEFAULT_PASSWORD=""
E2E_OWNER_A_PASSWORD=""
E2E_OWNER_B_PASSWORD=""

# Integrations
# Zalo, Telegram, Email SMTP, and SePay webhook keys are configured per tenant
# in Settings > Integration Center and stored in the database, not in env.
