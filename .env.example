# Database
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/homeland_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API
PORT=3001
NODE_ENV="development"
JWT_SECRET="homeland_super_secret_key_change_in_production"
APP_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ALLOW_REGISTRATION="false"
ENABLE_SWAGGER="true"
RUN_DB_MIGRATIONS="false"
INTERNAL_API_TOKEN=""
API_BODY_LIMIT="2mb"
DOCUMENT_UPLOAD_LIMIT_BYTES="20971520"
STORAGE_PROVIDER="local"
STORAGE_DIR=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
COMMUNICATION_IMMEDIATE_DELIVERY="true"
APP_RUNTIME_ROLE="all"
NOTIFICATION_WORKER_HEARTBEAT_PATH=".codex-runtime/notification-worker-heartbeat.json"
BACKUP_MANIFEST_PATH=".codex-backups/production/latest-manifest.json"
BACKUP_RETENTION_REPORT_PATH=".codex-backups/production/latest-retention-report.json"
BACKUP_RCLONE_DEST=""
PG_DUMP_PATH=""
PG_RESTORE_PATH=""
NEXT_PUBLIC_ALLOW_REGISTRATION="false"
MAINTENANCE_MODE="false"
NEXT_PUBLIC_MAINTENANCE_MODE="false"
MAINTENANCE_BYPASS_KEY=""

# Seed credentials (required when SEED_MODE=production; never commit real values)
SEED_DEFAULT_PASSWORD=""

# Optional local E2E credentials
E2E_DEFAULT_PASSWORD=""
E2E_ADMIN_PASSWORD=""
E2E_MANAGER_PASSWORD=""
E2E_SALES_PASSWORD=""
E2E_FINANCE_PASSWORD=""

# Integrations
# Zalo, Telegram, Email SMTP, and SePay webhook keys are configured per tenant
# in Settings > Integration Center and stored in the database, not in env.
# Hunonic mobile protocol signing keys are deployment secrets and must be
# injected by the production secret manager, never committed to Git.
HUNONIC_MOBILE_ACCESS_KEY=replace-with-hunonic-mobile-access-key
HUNONIC_MOBILE_SECRET_KEY=replace-with-hunonic-mobile-secret-key

# Optional local BIDV gateway prototype
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DATABASE="homeland"
BIDV_GATEWAY_PORT=8787
BIDV_GATEWAY_URL="http://localhost:8787/bank-events"
# Required only by scripts/bidv-app-ui-terminal.js. Do not commit a real device ID.
BIDV_DEVICE_SERIAL=""

# System update manager
# dry-run keeps the web-controlled update flow non-destructive.
APP_VERSION="v1.2.5"
SYSTEM_UPDATE_MODE="dry-run"
SYSTEM_UPDATE_REPOSITORY="https://github.com/tcandt/homeland-saas.git"
SYSTEM_UPDATE_GITHUB_TOKEN=""
SYSTEM_UPDATE_PREVIOUS_VERSION=""
SYSTEM_UPDATE_ROOT=".codex-update"
SYSTEM_UPDATE_ENV_FILE=""
SYSTEM_UPDATE_STORAGE_DIR=""
SYSTEM_UPDATE_BACKUP_OUTPUT_DIR=""
SYSTEM_UPDATE_BACKUP_MAX_AGE_HOURS="24"
SYSTEM_UPDATE_REQUIRE_OFF_HOST="false"
SYSTEM_UPDATE_SKIP_PG_RESTORE_LIST="false"
SYSTEM_UPDATE_AUTO_ROLLBACK="true"
SYSTEM_UPDATE_RUN_BUILD="true"
SYSTEM_UPDATE_ALLOW_SWITCH="false"
SYSTEM_UPDATE_RESTART_COMMAND=""
SYSTEM_UPDATE_PG_DUMP_PATH=""
SYSTEM_UPDATE_PG_RESTORE_PATH=""
SYSTEM_UPDATE_NPM_PATH=""
SYSTEM_UPDATE_POWERSHELL_PATH=""
SYSTEM_UPDATE_SHELL_PATH=""
SYSTEM_UPDATE_API_HEALTH_URL="http://127.0.0.1:3001/api/v1/health/ready"
SYSTEM_UPDATE_WEB_HEALTH_URL="http://127.0.0.1:3000/login"
SYSTEM_UPDATE_HEALTH_TIMEOUT_SECONDS="90"
