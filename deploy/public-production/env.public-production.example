# HomeLand production environment
# Official domain: https://homeland.ductinh.one
# Copy this file to deploy/public-production/env.public-production outside Git
# and replace every placeholder that is still unsafe for public exposure.

# PostgreSQL
POSTGRES_HOST_PORT=49189
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Redis
REDIS_HOST_PORT=49190

# Internal container ports
API_CONTAINER_PORT=39101
WEB_CONTAINER_PORT=39102

# Host ports exposed on Ubuntu
API_HOST_PORT=49188
WEB_HOST_PORT=49187

# Release metadata
APP_VERSION="v1.1.6"
API_TAG="v1.1.6"
WEB_TAG="v1.1.6"
COMMIT_SHA="replace-with-approved-commit-sha"
BUILD_ID="public-production"
BUILD_TIME="2026-08-24T00:00:00Z"

# Optional registry override
API_IMAGE="ghcr.io/tcandt/homeland-saas/homeland-api"
WEB_IMAGE="ghcr.io/tcandt/homeland-saas/homeland-web"

# Public URLs
APP_URL="https://homeland.ductinh.one"
CORS_ORIGINS="https://homeland.ductinh.one"
NEXT_PUBLIC_ALLOW_REGISTRATION="false"
NEXT_PUBLIC_MAINTENANCE_MODE="false"
MAINTENANCE_MODE="false"
MAINTENANCE_BYPASS_KEY="replace-with-strong-bypass-key"

# Runtime security
JWT_SECRET="replace-with-32-plus-char-jwt-secret"
ALLOW_REGISTRATION="false"
ENABLE_SWAGGER="false"
RUN_DB_MIGRATIONS="false"
COMMUNICATION_IMMEDIATE_DELIVERY="false"
APP_RUNTIME_ROLE_API="api"
APP_RUNTIME_ROLE_WORKER="notification-worker"
INTERNAL_API_TOKEN="replace-with-32-plus-char-internal-token"

# Storage
STORAGE_PROVIDER="local"
STORAGE_DIR="/app/storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# System update
SYSTEM_UPDATE_MODE="enabled"
SYSTEM_UPDATE_ALLOW_SWITCH="false"
SYSTEM_UPDATE_RESTART_COMMAND=""
SYSTEM_UPDATE_ROOT="/app/.codex-update"
SYSTEM_UPDATE_RUN_BUILD="true"

# Optional integrations
# Fresh production reset defaults to admin@homeland.vn / admin123456
# Keep SEED_FORCE_PASSWORD_CHANGE=true so first login must rotate the password.
SEED_DEFAULT_PASSWORD="admin123456"
SEED_FORCE_PASSWORD_CHANGE="true"
HUNONIC_MOBILE_ACCESS_KEY=""
HUNONIC_MOBILE_SECRET_KEY=""
CLOUDFLARE_TUNNEL_TOKEN=""

# Notes
# 1. If you switch to STORAGE_PROVIDER=s3 or r2, fill every S3_* variable.
# 2. If you change host ports, keep them in sync with Cloudflare Tunnel / reverse proxy.
# 3. Notification worker is expected to run alongside API when COMMUNICATION_IMMEDIATE_DELIVERY=false.
# 4. Replace POSTGRES_PASSWORD, JWT_SECRET, INTERNAL_API_TOKEN, and MAINTENANCE_BYPASS_KEY before opening the server publicly.
