{
  "annotations": { "list": [] },
  "description": "Search and explore distributed traces for HomeLand API. Correlate traces with Loki logs via Correlation ID.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "type": "traces",
      "title": "Trace Search",
      "description": "Search traces by service, operation, or duration. Click any trace to view spans.",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"homeland-api\"}",
          "limit": 20
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Trace Rate (spans/s)",
      "description": "Rate of spans generated by homeland-api",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(traces_spanmetrics_calls_total{service=\"homeland-api\"}[1m])",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "Trace P95 Duration by Operation",
      "description": "P95 span duration for top operations",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(traces_spanmetrics_duration_milliseconds_bucket{service=\"homeland-api\"}[5m])) by (le, operation)",
          "legendFormat": "p95 {{operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "nodeGraph",
      "title": "Service Graph",
      "description": "Dependency graph generated from trace data",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "serviceMap"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["homeland", "traces", "tempo", "opentelemetry"],
  "templating": {
    "list": [
      {
        "name": "operation",
        "type": "textbox",
        "label": "Operation (optional)",
        "description": "Filter traces by operation name",
        "current": { "value": "" },
        "hide": 0
      },
      {
        "name": "minDuration",
        "type": "textbox",
        "label": "Min Duration (ms)",
        "description": "Show only traces longer than this duration",
        "current": { "value": "" },
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "title": "HomeLand PMS — Trace Explorer",
  "uid": "homeland-traces",
  "version": 1
}
