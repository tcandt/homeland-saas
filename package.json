{
  "name": "homeland-saas",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/kill-dev-ports.js",
    "dev": "node scripts/dev.js",
    "build": "turbo run build",
    "prebuild": "npm run check:encoding",
    "lint": "turbo run lint",
    "prelint": "npm run check:encoding",
    "typecheck": "turbo run typecheck",
    "pretypecheck": "npm run check:encoding",
    "test": "turbo run test",
    "check:encoding": "node scripts/check-mojibake.js",
    "db:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=packages/database/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=packages/database/prisma/schema.prisma",
    "db:reset:prod": "cross-env SEED_MODE=production prisma db push --schema=packages/database/prisma/schema.prisma --force-reset && cross-env SEED_MODE=production prisma db seed --schema=packages/database/prisma/schema.prisma",
    "db:check-seed": "tsx packages/database/scripts/check-seed.ts",
    "preflight:prod": "node scripts/production-preflight.js",
    "bundle-preflight:prod": "node scripts/production-bundle-preflight.js",
    "host-check:prod": "node scripts/production-host-check.js",
    "backup:prod": "node scripts/production-backup.js",
    "backup:retention:prod": "node scripts/production-backup-retention.js",
    "backup:cycle:prod": "node scripts/production-backup-cycle.js",
    "storage:migrate:prod": "node scripts/storage-migrate-to-object-store.js",
    "storage:audit:prod": "node scripts/storage-audit.js",
    "storage:policy:prod": "node scripts/generate-object-storage-lifecycle-policy.js",
    "zalo:backfill:prod": "node scripts/backfill-zalo-customer-identities.js",
    "restore-check:prod": "node scripts/production-restore-check.js",
    "restore-drill:prod": "node scripts/production-restore-drill.js",
    "release-evidence:prod": "node scripts/generate-production-release-evidence.js",
    "cleanup:workspace": "node scripts/cleanup-workspace.js --apply",
    "test:preflight:prod": "node --test scripts/production-preflight.test.js scripts/production-bundle-preflight.test.js scripts/production-host-check.test.js scripts/production-backup.test.js scripts/production-backup-retention.test.js scripts/production-backup-cycle.test.js scripts/production-restore-check.test.js scripts/production-restore-drill.test.js scripts/production-scheduler-layout.test.js scripts/production-registry-layout.test.js scripts/storage-migrate-to-object-store.test.js scripts/storage-audit.test.js scripts/generate-object-storage-lifecycle-policy.test.js scripts/generate-production-release-evidence.test.js scripts/cleanup-workspace.test.js scripts/backfill-zalo-customer-identities.test.js scripts/ci-workflow-safety.test.js",
    "api:dev": "npm run dev --workspace=api",
    "web:dev": "npm run dev --workspace=web",
    "phase2:verify": "npm run db:generate && npm run db:push && npm run db:seed && npm run db:check-seed",
    "verify:prod": "powershell -ExecutionPolicy Bypass -File scripts/verify-production.ps1",
    "eos:matrix": "tsx scripts/eos/generate-matrix.ts",
    "eos:dashboard": "tsx scripts/eos/generate-dashboard.ts",
    "eos:start": "tsx scripts/eos/start-execution.ts",
    "eos:record": "powershell -ExecutionPolicy Bypass -File scripts/eos/record-evidence.ps1",
    "eos:validate": "tsx scripts/eos/validate-evidence.ts",
    "eos:receipt": "tsx scripts/eos/generate-receipt.ts",
    "eos:test": "tsx scripts/eos/test-evidence-protection.ts",
    "eos:gate": "tsx scripts/eos/generate-gate.ts",
    "eos:verify": "tsx scripts/eos/verify-pipeline.ts",
    "eos:self-test": "tsx scripts/eos/test-planner.ts",
    "eos:verify-event": "tsx scripts/eos/verify-event-log.ts",
    "eos:policy-eval": "tsx scripts/eos/policy-engine.ts",
    "eos:verify-v4": "tsx --env-file=.env scripts/eos/verify-pipeline.ts",
    "eos:test-v5": "tsx scripts/eos/test-v5.ts"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.7.1",
    "turbo": "latest",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "tsx packages/database/prisma/seed.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mongodb": "^7.5.0"
  },
  "overrides": {
    "next": "^16.2.11",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "brace-expansion": "^2.1.4",
    "js-yaml": "^4.3.1",
    "lodash": "^4.18.1",
    "multer": "^2.3.0",
    "@opentelemetry/propagator-jaeger": "^2.11.0",
    "glob": "^10.5.0"
  }
}
